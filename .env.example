# domain-monitor configuration. Copy to .env and fill in.
# .env holds SECRETS and OPERATIONAL SETTINGS ONLY -- rules live in rules.yaml, because
# regexes contain characters ($ # " \) that dotenv parsing and `set -a` sourcing mangle,
# and because rule changes deserve a readable diff.
#
# The real .env must never be committed.

# --- database -------------------------------------------------------------------
DATABASE_URL=sqlite:///data/domain_monitor.db
# PostgreSQL, no code changes needed:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/domain_monitor

# --- monitoring -----------------------------------------------------------------
MONITOR_TLDS=ch,li
TIMEZONE=Europe/Zurich

# --- zone transfer --------------------------------------------------------------
# Switch publishes the .ch/.li zones as open data, restricted to "combating cybercrime,
# scientific and social research or for other purposes in the public interest", and asks
# that the zone be downloaded no more than once every 24 hours.
# Request a TSIG key: https://www.switch.ch/open-data/
CH_ZONE_SERVER=zonedata.switch.ch
CH_TSIG_KEY_NAME=
CH_TSIG_SECRET=
CH_TSIG_ALGORITHM=hmac-sha512

LI_ZONE_SERVER=zonedata.switch.ch
LI_TSIG_KEY_NAME=
LI_TSIG_SECRET=
LI_TSIG_ALGORITHM=hmac-sha512

# Offline/testing source: a one-name-per-line file, used instead of AXFR when set.
# CH_ZONE_FILE=data/ch.txt
# LI_ZONE_FILE=data/li.txt

# The 24h interval is enforced in code, not just documented: a run inside this window
# reuses the stored state instead of re-transferring. Running cron more often than this
# is harmless, just pointless.
ZONE_MIN_TRANSFER_INTERVAL_HOURS=24

# Reject a transfer smaller than this fraction of the previous one. A partial transfer
# is more dangerous than an empty one because it looks plausible.
ZONE_MIN_RATIO=0.5

# --- rules ----------------------------------------------------------------------
DOMAIN_RULES_PATH=rules.yaml

# --- SMTP -----------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=mail.example.ch
SMTP_PORT=587
SMTP_USERNAME=domain-monitor@example.ch
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=domain-monitor@example.ch
# Comma-separated for multiple recipients.
SMTP_TO=security@example.ch
SMTP_TIMEOUT=30

# --- alerting -------------------------------------------------------------------
CONSOLE_ALERTS=true

# --- application ----------------------------------------------------------------
LOG_LEVEL=INFO
LOCK_PATH=/tmp/domain-monitor.lock
